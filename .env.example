# ============================================================
# GhettoBarberTattoo — Variables de entorno (referencia)
# ============================================================
# Copiá este archivo como .env y completá los valores reales.
# El .env real está excluido del repo (ver .gitignore).
#
# Dónde conseguir estos valores:
#   https://app.supabase.com → tu proyecto → Settings → API
# ============================================================

# URL del proyecto Supabase (ej: https://abcdefgh.supabase.co)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública "anon" (safe para usar en el cliente)
# NO uses la clave "service_role" acá — esa es solo para servidor.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Emails de administradores autorizados (separados por coma)
ADMIN_EMAILS=celeste@elghetto.tattoo
